# Environment Configuration

# Database (PostgreSQL)
POSTGRES_USER=homeexpense
POSTGRES_PASSWORD=homeexpense_secret_password
POSTGRES_DB=homeexpense_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://homeexpense:homeexpense_secret_password@localhost:5432/homeexpense_db?schema=public"

# Redis
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# API Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_must_be_changed_in_production_min32chars
JWT_EXPIRES_IN=7d

# Web / Client Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
