# Production Environment Template
NODE_ENV=production
PORT=4000

# PostgreSQL (Production Cloud Managed / Neon / AWS Aurora)
DATABASE_URL="postgresql://prod_user:SECURE_PASSWORD_INJECTED_VIA_VAULT@prod-db.homeexpense.internal:5432/homeexpense_prod?sslmode=require"

# Redis
REDIS_URL="redis://prod-redis.homeexpense.internal:6379"

# Security (64-byte Hex / Cryptographically Random)
JWT_SECRET="SET_VIA_AWS_SECRETS_MANAGER_OR_VAULT_MIN_32_CHARS"
JWT_EXPIRES_IN="7d"

# Web Client
NEXT_PUBLIC_API_URL="https://api.homeexpense.app/api/v1"
