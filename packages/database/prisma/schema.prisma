datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum HomeType {
  BACHELOR
  FAMILY
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ExpenseCategory {
  GROCERIES
  RENT
  UTILITIES
  DINING_OUT
  ENTERTAINMENT
  TRAVEL
  HEALTHCARE
  HOUSEHOLD_SUPPLIES
  MAINTENANCE
  OTHER
}

enum SplitType {
  EQUAL
  EXACT
  PERCENTAGE
  SHARES
}

enum SettlementStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  SETTLE
  INVITE
  INVITE_ACCEPT
  INVITE_REJECT
  INVITE_REVOKE
  ROLE_CHANGE
  MEMBER_DEACTIVATE
  LOGIN
  FAILED_LOGIN
  LOGOUT
  PASSWORD_CHANGE
  PASSWORD_RESET
  ACCOUNT_DEACTIVATE
  EMAIL_VERIFY
  ARCHIVE
  RESTORE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  REVOKED
}

enum BillStatus {
  UNPAID
  PAID
  OVERDUE
}

enum RecurringInterval {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum HealthStatus {
  EXCELLENT
  HEALTHY
  WATCH
  AT_RISK
  CRITICAL
  BUILDING_PROFILE
}

enum InsightSeverity {
  CRITICAL
  WARNING
  INFO
  POSITIVE
}

enum DataSufficiency {
  FULL
  PARTIAL
  INSUFFICIENT
}

model User {
  id                       String    @id @default(uuid()) @db.Uuid
  email                    String    @unique
  passwordHash             String
  name                     String
  avatarUrl                String?
  emailVerified            Boolean   @default(false)
  emailVerificationToken   String?
  emailVerificationExpires DateTime?
  passwordResetToken       String?
  passwordResetExpires     DateTime?
  failedLoginAttempts      Int       @default(0)
  lockoutUntil             DateTime?
  isDeactivated            Boolean   @default(false)
  deactivatedAt            DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  members         HomeMember[]
  auditLogs       AuditLog[]
  sessions        Session[]
  sentInvitations HomeInvitation[] @relation("SentInvitations")

  @@map("users")
}

model Session {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  refreshTokenHash String   @unique
  userAgent        String?
  ipAddress        String?
  isValid          Boolean  @default(true)
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Home {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  type        HomeType  @default(BACHELOR)
  currency    String    @default("INR") @db.VarChar(3)
  description String?
  isArchived  Boolean   @default(false)
  archivedAt  DateTime?
  inviteCode  String?   @unique @db.VarChar(12)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members           HomeMember[]
  invitations       HomeInvitation[]
  expenses          Expense[]
  ledgerEntries     LedgerEntry[]
  settlements       Settlement[]
  auditLogs         AuditLog[]
  budgets           Budget[]
  bills             Bill[]
  recurringExpenses RecurringExpense[]
  healthSnapshots   FinancialHealthSnapshot[]
  healthInsights    FinancialHealthInsight[]

  @@map("homes")
}

model HomeMember {
  id            String     @id @default(uuid()) @db.Uuid
  homeId        String     @db.Uuid
  userId        String     @db.Uuid
  role          MemberRole @default(MEMBER)
  nickname      String?
  spendingLimit Decimal?   @db.Decimal(12, 2)
  isActive      Boolean    @default(true)
  deactivatedAt DateTime?
  joinedAt      DateTime   @default(now())

  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  paidExpenses        Expense[]          @relation("ExpensePayer")
  expenseSplits       ExpenseSplit[]
  debts               LedgerEntry[]      @relation("DebtorMember")
  credits             LedgerEntry[]      @relation("CreditorMember")
  settlementsSent     Settlement[]       @relation("SettlementPayer")
  settlementsReceived Settlement[]       @relation("SettlementPayee")
  recurringExpenses   RecurringExpense[] @relation("RecurringPayer")

  @@unique([homeId, userId])
  @@index([homeId])
  @@index([userId])
  @@map("home_members")
}

model HomeInvitation {
  id           String           @id @default(uuid()) @db.Uuid
  homeId       String           @db.Uuid
  invitedEmail String
  role         MemberRole       @default(MEMBER)
  token        String           @unique
  status       InvitationStatus @default(PENDING)
  invitedById  String           @db.Uuid
  expiresAt    DateTime
  acceptedAt   DateTime?
  rejectedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  home      Home @relation(fields: [homeId], references: [id], onDelete: Cascade)
  invitedBy User @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([homeId])
  @@index([invitedEmail])
  @@map("home_invitations")
}

model Expense {
  id            String          @id @default(uuid()) @db.Uuid
  homeId        String          @db.Uuid
  payerMemberId String          @db.Uuid
  amount        Decimal         @db.Decimal(12, 2)
  description   String
  category      ExpenseCategory @default(OTHER)
  splitType     SplitType       @default(EQUAL)
  receiptUrl    String?
  notes         String?
  date          DateTime        @default(now())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  home  Home       @relation(fields: [homeId], references: [id], onDelete: Cascade)
  payer HomeMember @relation("ExpensePayer", fields: [payerMemberId], references: [id], onDelete: Restrict)

  splits        ExpenseSplit[]
  ledgerEntries LedgerEntry[]

  @@index([homeId, date])
  @@index([homeId, payerMemberId])
  @@map("expenses")
}

model ExpenseSplit {
  id         String   @id @default(uuid()) @db.Uuid
  expenseId  String   @db.Uuid
  memberId   String   @db.Uuid
  amount     Decimal  @db.Decimal(12, 2)
  percentage Decimal? @db.Decimal(5, 2)
  shares     Int?
  createdAt  DateTime @default(now())

  expense Expense    @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  member  HomeMember @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([expenseId, memberId])
  @@index([expenseId])
  @@index([memberId])
  @@map("expense_splits")
}

model LedgerEntry {
  id               String   @id @default(uuid()) @db.Uuid
  homeId           String   @db.Uuid
  expenseId        String?  @db.Uuid
  settlementId     String?  @db.Uuid
  debtorMemberId   String   @db.Uuid
  creditorMemberId String   @db.Uuid
  amount           Decimal  @db.Decimal(12, 2)
  notes            String?
  createdAt        DateTime @default(now())

  home       Home        @relation(fields: [homeId], references: [id], onDelete: Cascade)
  expense    Expense?    @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  settlement Settlement? @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  debtor     HomeMember  @relation("DebtorMember", fields: [debtorMemberId], references: [id], onDelete: Restrict)
  creditor   HomeMember  @relation("CreditorMember", fields: [creditorMemberId], references: [id], onDelete: Restrict)

  @@index([homeId, createdAt])
  @@index([debtorMemberId, creditorMemberId])
  @@index([creditorMemberId, debtorMemberId])
  @@map("ledger_entries")
}

model Settlement {
  id           String           @id @default(uuid()) @db.Uuid
  homeId       String           @db.Uuid
  fromMemberId String           @db.Uuid
  toMemberId   String           @db.Uuid
  amount       Decimal          @db.Decimal(12, 2)
  proofUrl     String?
  notes        String?
  status       SettlementStatus @default(CONFIRMED)
  settledAt    DateTime         @default(now())
  createdAt    DateTime         @default(now())

  home       Home       @relation(fields: [homeId], references: [id], onDelete: Cascade)
  fromMember HomeMember @relation("SettlementPayer", fields: [fromMemberId], references: [id], onDelete: Restrict)
  toMember   HomeMember @relation("SettlementPayee", fields: [toMemberId], references: [id], onDelete: Restrict)

  ledgerEntries LedgerEntry[]

  @@index([homeId, settledAt])
  @@map("settlements")
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  homeId      String?     @db.Uuid
  actorUserId String      @db.Uuid
  action      AuditAction
  entityType  String
  entityId    String      @db.Uuid
  payload     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  home  Home? @relation(fields: [homeId], references: [id], onDelete: Cascade)
  actor User  @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([homeId, createdAt])
  @@index([actorUserId])
  @@map("audit_logs")
}

model Budget {
  id          String   @id @default(uuid()) @db.Uuid
  homeId      String   @db.Uuid
  month       Int
  year        Int
  totalBudget Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  home       Home             @relation(fields: [homeId], references: [id], onDelete: Cascade)
  categories BudgetCategory[]

  @@unique([homeId, year, month])
  @@index([homeId])
  @@map("budgets")
}

model BudgetCategory {
  id              String          @id @default(uuid()) @db.Uuid
  budgetId        String          @db.Uuid
  category        ExpenseCategory
  allocatedAmount Decimal         @db.Decimal(12, 2)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, category])
  @@index([budgetId])
  @@map("budget_categories")
}

model Bill {
  id              String     @id @default(uuid()) @db.Uuid
  homeId          String     @db.Uuid
  title           String     @db.VarChar(150)
  amount          Decimal    @db.Decimal(12, 2)
  dueDate         DateTime
  status          BillStatus @default(UNPAID)
  billDocumentUrl String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)

  @@index([homeId, dueDate])
  @@index([homeId, status])
  @@map("bills")
}

model RecurringExpense {
  id            String            @id @default(uuid()) @db.Uuid
  homeId        String            @db.Uuid
  payerMemberId String            @db.Uuid
  amount        Decimal           @db.Decimal(12, 2)
  description   String            @db.VarChar(255)
  category      ExpenseCategory   @default(OTHER)
  interval      RecurringInterval @default(MONTHLY)
  nextRunAt     DateTime
  splitType     SplitType         @default(EQUAL)
  active        Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  home  Home       @relation(fields: [homeId], references: [id], onDelete: Cascade)
  payer HomeMember @relation("RecurringPayer", fields: [payerMemberId], references: [id], onDelete: Restrict)

  @@index([homeId, active])
  @@index([homeId, nextRunAt])
  @@map("recurring_expenses")
}

model FinancialHealthSnapshot {
  id              String          @id @default(uuid()) @db.Uuid
  homeId          String          @db.Uuid
  periodStart     DateTime
  periodEnd       DateTime
  score           Int?
  status          HealthStatus
  scoringVersion  String          @db.VarChar(50)
  profile         HomeType
  dataSufficiency DataSufficiency
  dimensionScores Json
  metrics         Json
  createdAt       DateTime        @default(now())

  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)

  @@index([homeId, createdAt])
  @@index([homeId, periodStart, periodEnd])
  @@map("financial_health_snapshots")
}

model FinancialHealthInsight {
  id             String          @id @default(uuid()) @db.Uuid
  homeId         String          @db.Uuid
  type           String          @db.VarChar(50)
  severity       InsightSeverity
  title          String          @db.VarChar(200)
  description    String          @db.Text
  affectedDomain String          @db.VarChar(50)
  metricValue    Decimal?        @db.Decimal(12, 2)
  thresholdValue Decimal?        @db.Decimal(12, 2)
  entityType     String?         @db.VarChar(50)
  entityId       String?         @db.Uuid
  status         String          @default("ACTIVE") @db.VarChar(20)
  scoringVersion String          @db.VarChar(50)
  createdAt      DateTime        @default(now())
  resolvedAt     DateTime?

  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)

  @@index([homeId, status])
  @@index([homeId, createdAt])
  @@map("financial_health_insights")
}
