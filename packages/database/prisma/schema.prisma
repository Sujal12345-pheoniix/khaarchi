datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum HomeType {
  BACHELOR
  FAMILY
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ExpenseCategory {
  GROCERIES
  RENT
  UTILITIES
  DINING_OUT
  ENTERTAINMENT
  TRAVEL
  HEALTHCARE
  HOUSEHOLD_SUPPLIES
  MAINTENANCE
  OTHER
}

enum SplitType {
  EQUAL
  EXACT
  PERCENTAGE
  SHARES
}

enum SettlementStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  SETTLE
  INVITE
  INVITE_ACCEPT
  INVITE_REJECT
  INVITE_REVOKE
  ROLE_CHANGE
  MEMBER_DEACTIVATE
  LOGIN
  FAILED_LOGIN
  LOGOUT
  PASSWORD_CHANGE
  PASSWORD_RESET
  ACCOUNT_DEACTIVATE
  EMAIL_VERIFY
  ARCHIVE
  RESTORE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  REVOKED
}

model User {
  id                         String    @id @default(uuid()) @db.Uuid
  email                      String    @unique
  passwordHash               String
  name                       String
  avatarUrl                  String?
  emailVerified              Boolean   @default(false)
  emailVerificationToken     String?
  emailVerificationExpires   DateTime?
  passwordResetToken         String?
  passwordResetExpires       DateTime?
  failedLoginAttempts        Int       @default(0)
  lockoutUntil               DateTime?
  isDeactivated              Boolean   @default(false)
  deactivatedAt              DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  members         HomeMember[]
  auditLogs       AuditLog[]
  sessions        Session[]
  sentInvitations HomeInvitation[] @relation("SentInvitations")

  @@map("users")
}

model Session {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  refreshTokenHash String   @unique
  userAgent        String?
  ipAddress        String?
  isValid          Boolean  @default(true)
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Home {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  type        HomeType  @default(BACHELOR)
  currency    String    @default("INR") @db.VarChar(3)
  description String?
  isArchived  Boolean   @default(false)
  archivedAt  DateTime?
  inviteCode  String?   @unique @db.VarChar(12)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members       HomeMember[]
  invitations   HomeInvitation[]
  expenses      Expense[]
  ledgerEntries LedgerEntry[]
  settlements   Settlement[]
  auditLogs     AuditLog[]

  @@map("homes")
}

model HomeMember {
  id            String     @id @default(uuid()) @db.Uuid
  homeId        String     @db.Uuid
  userId        String     @db.Uuid
  role          MemberRole @default(MEMBER)
  nickname      String?
  spendingLimit Decimal?   @db.Decimal(12, 2)
  isActive      Boolean    @default(true)
  deactivatedAt DateTime?
  joinedAt      DateTime   @default(now())

  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  paidExpenses        Expense[]      @relation("ExpensePayer")
  expenseSplits       ExpenseSplit[]
  debts               LedgerEntry[]  @relation("DebtorMember")
  credits             LedgerEntry[]  @relation("CreditorMember")
  settlementsSent     Settlement[]   @relation("SettlementPayer")
  settlementsReceived Settlement[]   @relation("SettlementPayee")

  @@unique([homeId, userId])
  @@index([homeId])
  @@index([userId])
  @@map("home_members")
}

model HomeInvitation {
  id           String           @id @default(uuid()) @db.Uuid
  homeId       String           @db.Uuid
  invitedEmail String
  role         MemberRole       @default(MEMBER)
  token        String           @unique
  status       InvitationStatus @default(PENDING)
  invitedById  String           @db.Uuid
  expiresAt    DateTime
  acceptedAt   DateTime?
  rejectedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  home      Home @relation(fields: [homeId], references: [id], onDelete: Cascade)
  invitedBy User @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([homeId])
  @@index([invitedEmail])
  @@map("home_invitations")
}

model Expense {
  id            String          @id @default(uuid()) @db.Uuid
  homeId        String          @db.Uuid
  payerMemberId String          @db.Uuid
  amount        Decimal         @db.Decimal(12, 2)
  description   String
  category      ExpenseCategory @default(OTHER)
  splitType     SplitType       @default(EQUAL)
  receiptUrl    String?
  notes         String?
  date          DateTime        @default(now())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  home  Home       @relation(fields: [homeId], references: [id], onDelete: Cascade)
  payer HomeMember @relation("ExpensePayer", fields: [payerMemberId], references: [id], onDelete: Restrict)

  splits        ExpenseSplit[]
  ledgerEntries LedgerEntry[]

  @@index([homeId, date])
  @@index([homeId, payerMemberId])
  @@map("expenses")
}

model ExpenseSplit {
  id         String   @id @default(uuid()) @db.Uuid
  expenseId  String   @db.Uuid
  memberId   String   @db.Uuid
  amount     Decimal  @db.Decimal(12, 2)
  percentage Decimal? @db.Decimal(5, 2)
  shares     Int?
  createdAt  DateTime @default(now())

  expense Expense    @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  member  HomeMember @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([expenseId, memberId])
  @@index([expenseId])
  @@index([memberId])
  @@map("expense_splits")
}

model LedgerEntry {
  id               String   @id @default(uuid()) @db.Uuid
  homeId           String   @db.Uuid
  expenseId        String?  @db.Uuid
  settlementId     String?  @db.Uuid
  debtorMemberId   String   @db.Uuid
  creditorMemberId String   @db.Uuid
  amount           Decimal  @db.Decimal(12, 2)
  notes            String?
  createdAt        DateTime @default(now())

  home       Home        @relation(fields: [homeId], references: [id], onDelete: Cascade)
  expense    Expense?    @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  settlement Settlement? @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  debtor     HomeMember  @relation("DebtorMember", fields: [debtorMemberId], references: [id], onDelete: Restrict)
  creditor   HomeMember  @relation("CreditorMember", fields: [creditorMemberId], references: [id], onDelete: Restrict)

  @@index([homeId, createdAt])
  @@index([debtorMemberId, creditorMemberId])
  @@index([creditorMemberId, debtorMemberId])
  @@map("ledger_entries")
}

model Settlement {
  id           String           @id @default(uuid()) @db.Uuid
  homeId       String           @db.Uuid
  fromMemberId String           @db.Uuid
  toMemberId   String           @db.Uuid
  amount       Decimal          @db.Decimal(12, 2)
  proofUrl     String?
  notes        String?
  status       SettlementStatus @default(CONFIRMED)
  settledAt    DateTime         @default(now())
  createdAt    DateTime         @default(now())

  home       Home       @relation(fields: [homeId], references: [id], onDelete: Cascade)
  fromMember HomeMember @relation("SettlementPayer", fields: [fromMemberId], references: [id], onDelete: Restrict)
  toMember   HomeMember @relation("SettlementPayee", fields: [toMemberId], references: [id], onDelete: Restrict)

  ledgerEntries LedgerEntry[]

  @@index([homeId, settledAt])
  @@map("settlements")
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  homeId      String?     @db.Uuid
  actorUserId String      @db.Uuid
  action      AuditAction
  entityType  String
  entityId    String      @db.Uuid
  payload     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  home  Home? @relation(fields: [homeId], references: [id], onDelete: Cascade)
  actor User  @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([homeId, createdAt])
  @@index([actorUserId])
  @@map("audit_logs")
}
