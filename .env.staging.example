# Staging Environment Template
NODE_ENV=staging
PORT=4000

# PostgreSQL (Cloud Managed / AWS RDS / Neon Staging)
DATABASE_URL="postgresql://staging_user:staging_password@staging-db.homeexpense.internal:5432/homeexpense_staging?sslmode=require"

# Redis
REDIS_URL="redis://staging-redis.homeexpense.internal:6379"

# Security (Minimum 32 characters)
JWT_SECRET="staging_super_secret_jwt_key_must_be_minimum_32_characters_long"
JWT_EXPIRES_IN="7d"

# Web Client
NEXT_PUBLIC_API_URL="https://staging-api.homeexpense.app/api/v1"
