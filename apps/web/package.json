{
  "name": "@homeexpense/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build:packages": "pnpm --filter \"@homeexpense/types\" --filter \"@homeexpense/validation\" --filter \"@homeexpense/financial-core\" --filter \"@homeexpense/shared\" --filter \"@homeexpense/ui\" --filter \"@homeexpense/config\" run build",
    "build": "pnpm run build:packages && next build",
    "start": "next start -p 3000",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@homeexpense/config": "workspace:*",
    "@homeexpense/financial-core": "workspace:*",
    "@homeexpense/shared": "workspace:*",
    "@homeexpense/types": "workspace:*",
    "@homeexpense/ui": "workspace:*",
    "@homeexpense/validation": "workspace:*",
    "@tanstack/react-query": "^5.66.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
